def counter():
    global wheel
    if wheel >= 5:
        wheel = 1
    else:
        wheel += 1
    global wheel_text
    wheel_text = FONT.render(str(wheel), True, BLACK)


class Object:
    def __init__(self, image):

        self.image = image
        
    
    def draw(self):
        WINDOW.blit(pygame.transform.scale(self.image, (WINDOW_WIDTH, WINDOW_HEIGHT)), (0, 0))
    
    def get_name(self):
        return self.name

class Highlight(Object):
    def __init__(self, image):
        super().__init__(image)
        highlights.append(self)
        self.countdown =  0 
        
    def update (self, num):
        self.draw()
        self.countdown += 1
        if self.countdown >= 60:
            self.destroy()

    def destroy(self):
        highlights.pop(0)
        self.countdown = 0
        
def load_chords ():
    global chords
    if wheel == 1: 
        chords = ["B  ", "C#m", "D#m", "E  ", "F#  ", "G#m"]
    elif wheel == 2:
        chords = ["C   ", "DDm ", "Em ", "F   ", "G   ", "Am "]
    elif wheel == 3:
        chords = ["D♭ ", "E♭m", "Fm ", "G♭ ", "A♭ ", "B♭m"]
    elif wheel == 4:
        chords =  ["D  ", "Em ", "F#m ", "G  ", "A  ", "Bm "]
    elif wheel == 5:
        chords = ["E♭ ", "Fm ", "Gm ", "A♭ ", "B♭ ", "Cm "]

def print_chords():
    angle = 15
    radius = 195
    for chord in chords:
        text = FONT.render(chord, True, BLACK)
        x = WINDOW_WIDTH//2 - radius * math.cos(math.radians(angle))
        y = WINDOW_HEIGHT//2 - radius * math.sin(math.radians(angle))
        WINDOW.blit(text, (x, y))
        angle += 30

while True:
    WINDOW.blit(background, (10, 0))
    WINDOW.blit(wheel_text, (WINDOW_WIDTH//2 - wheel_text.get_width()//2, WINDOW_HEIGHT//2 - wheel_text.get_height()))
    CLOCK.tick(60)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            exit()
        elif event.type == pygame.KEYDOWN:
            check_input(event.key, True)
    for high in highlights:
        i = 0
        high.update(i)
        i += 1
    load_chords()
    print_chords()
    pygame.display.update()
            