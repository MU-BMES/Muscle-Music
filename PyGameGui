def counter():
    global wheel
    if wheel >= 5:
        wheel = 0
    else:
        wheel += 1
    global wheel_text
    wheel_text = FONT.render(str(wheel), True, BLACK)


class Object:
    def __init__(self, name, image):

        self.name = name
        print(self.name)
        self.image = image
        objects.append(self)
        global num_objects
        num_objects += 1
        self.countdown =  0 
    
    def draw(self):
        WINDOW.blit(pygame.transform.scale(self.image, (WINDOW_WIDTH, WINDOW_HEIGHT)), (0, 0))
    
    def update (self, num):
        self.draw()
        self.countdown += 1
        print(self.countdown)
        if self.countdown >= 60:
            self.destroy()

    def destroy(self):
        objects.pop(0)
        global num_objects
        num_objects -= 1
        self.countdown = 0

    def get_name(self):
        return self.name

