import pygame
from PIL import Image, ImageDraw

pygame.init()
WINDOW_WIDTH, WINDOW_HEIGHT = 1200, 750
WINDOW = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
pygame.display.set_caption("Muscle-Music")

CLOCK = pygame.time.Clock()

player_input = {"one": False, "two": False, "three": False, "four": False, "five": False, "six": False}

background = pygame.transform.scale(pygame.image.load("assets/background.PNG"), (WINDOW_WIDTH, WINDOW_HEIGHT))

def check_input(key, val):
    if key == pygame.K_1:
        player_input["one"] = val
    elif key == pygame.K_2:
        player_input["two"] = val
    elif key == pygame.K_3:
        player_input["three"] = val
    elif key == pygame.K_4:
        player_input["four"] = val
    elif key == pygame.K_5:
        player_input["five"] = val
    elif key == pygame.K_6:
        player_input["six"] = val
class Object:
    def __init__(self, image):
        self.image = image
        print("Object created with image:", image)

    def draw(self):
        slice = pygame.transform.scale(pygame.image.load("assets/background.PNG"), (WINDOW_WIDTH, WINDOW_HEIGHT))
        WINDOW.blit(slice, (0, 0))

slice1 = Object("assets/slice1.PNG")
slice2 = Object("assets/slice2.PNG")
slice3 = Object("assets/slice3.PNG")
slice4 = Object("assets/slice4.PNG")
slice5 = Object("assets/slice5.PNG")
slice6 = Object("assets/slice6.PNG")
while True:

    WINDOW.blit(background, (0, 0))
    pygame.display.update()
    CLOCK.tick(60)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            exit()
        elif event.type == pygame.KEYDOWN:
            check_input(event.key, True)
        elif event.type == pygame.KEYUP:
            check_input(event.key, False)
    if player_input["one"]:
       WINDOW.blit( pygame.transform.scale(slice1.image, (WINDOW_WIDTH, WINDOW_HEIGHT)), (0, 0))
    elif player_input["two"]:
        slice2.draw()
    elif player_input["three"]:
        slice3.draw()
    elif player_input["four"]:
        slice4.draw()
    elif player_input["five"]:
        slice5.draw()
    elif player_input["six"]:
        slice6.draw()

            