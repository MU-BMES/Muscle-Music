WHITE = (255, 255, 255)


WINDOW = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
pygame.display.set_caption("Muscle-Music")

CLOCK = pygame.time.Clock()

player_input = {"one": False, "two": False, "three": False, "four": False, "five": False, "six": False, "space": False}
wheel = 1
wheel_text = FONT.render(str(wheel), True, BLACK)
background = pygame.transform.scale(pygame.image.load("assets/background.PNG"), (WINDOW_WIDTH, WINDOW_HEIGHT))
highlights = []
chords = ["B  ", "C#m", "D#m", "E  ", "F#  ", "G#m"]

