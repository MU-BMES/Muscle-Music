class Object:
    def __init__(self, image):
        self.image = image

    def draw(self):
        WINDOW.blit(pygame.transform.scale(self.image, (WINDOW_WIDTH, WINDOW_HEIGHT)), (0, 0))

class Text(Object):
    def __init__(self, text, xpos, ypos):
        super().__init__(text)
        self.text = text
        self.xpos = xpos
        self.ypos = ypos
        self.countdown = 0

    def draw(self):
        WINDOW.blit(FONT_START.render(self.text, True, BLACK), (self.xpos, self.ypos))

    def flash(self, num):
        global show
        if show == False:
            self.countdown += 1   
            if self.countdown >= num:
                self.countdown = 0
                show = True
        elif show == True:
            self.draw()
            self.countdown += 1
            if self.countdown >= num:
                self.countdown = 0
                show = False


class Highlight(Object):
    def __init__(self, image):
        super().__init__(image)
        highlights.append(self)
        self.countdown =  0 
        global active_highlight
        active_highlight = True
        
    def update (self):
        self.draw()
        self.countdown += 1 
        if self.countdown >= 30:
            self.destroy()

    def destroy(self):
        mixer.music.stop()
        global chord_num
        chord_num = -1
        highlights.pop(0)
        self.countdown = 0
        global active_highlight
        active_highlight = False

def load_chords ():
    global chords
    if wheel == 1: 
        chords = ["B", "C#m", "D#m", "E", "F#", "G#m", "B maj"]
    elif wheel == 2:
        chords = ["C", "Dm", "Em", "F", "G", "Am", "C maj"]
    elif wheel == 3:
        chords = ["D♭", "E♭m", "Fm", "G♭", "A♭", "B♭m", "Db maj" ]
    elif wheel == 4:
        chords =  ["D", "Em", "F#m", "G", "A", "Bm", "D maj"]
    elif wheel == 5:
        chords = ["E♭", "Fm", "Gm", "A♭", "B♭", "Cm", "Eb maj"]

def print_chords():
    angle = 15
    radius = 230
    for i in range(len(chords) - 1):
        chord = chords[i]
        text = FONT.render(chord, True, BLACK)
        x = WINDOW_WIDTH//2 - radius * math.cos(math.radians(angle))  - text.get_width()//2
        y = WINDOW_HEIGHT//2 - radius * math.sin(math.radians(angle)) -  text.get_height()//2
        WINDOW.blit(text, (x, y))
        angle += 30

def counter():
    global wheel
    if wheel >= 5:
        wheel = 1
    else:
        wheel += 1
    global wheel_text
    wheel_text = FONT_WHEEL.render(str(wheel), True, BLACK)
def set_fingering():
